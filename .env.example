EMBEDDING_PROVIDER=tei
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
TEI_EMBEDDING_URL=https://your-workspace--travel-agent-tei-bge-m3-tei-server.modal.run/embed
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_BATCH_SIZE=8
EMBEDDING_FALLBACK_TO_LOCAL=false

RETRIEVER_MODE=hybrid
RAG_COLLECTION_NAME=vietnam_travel_parent_child
HYBRID_CANDIDATE_K=30
HYBRID_DENSE_WEIGHT=0.65
HYBRID_BM25_WEIGHT=0.35
HYBRID_RRF_K=60

ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=travel_child_chunks_v1
ELASTICSEARCH_VERIFY_CERTS=false
ELASTICSEARCH_REQUEST_TIMEOUT=30

BENCHMARK_MODEL=gemini-3.5-flash-lite
GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=your_gemini_api_key_here

RERANKER_ENABLED=true
RERANKER_PROVIDER=tei
TEI_RERANK_URL=https://your-workspace--travel-agent-tei-reranker-tei-server-dev.modal.run/rerank
RERANKER_TIMEOUT_SECONDS=120
RERANKER_CANDIDATE_K=5
RERANKER_BATCH_SIZE=8
RERANKER_MAX_TEXT_CHARS=500
RERANKER_RAW_SCORES=false
