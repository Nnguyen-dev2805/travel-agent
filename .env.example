# --- Base LLM Configuration ---
GOOGLE_API_KEY=lm-studio
LLM_MODEL=qwen2.5-7b-instruct-1m
LLM_BASE_URL=http://host.docker.internal:1234/v1

# --- Multi-model Configuration ---
# You can override specific components to use different models.
# If not set, they will fallback to LLM_MODEL above.
# MAIN_LLM_MODEL=qwen2.5-7b-instruct-1m
# ROUTER_MODEL=qwen2.5-7b-instruct-1m
# MEMORY_EXTRACTION_MODEL=qwen2.5-7b-instruct-1m
# CONFLICT_RESOLUTION_MODEL=qwen2.5-7b-instruct-1m
# EVALUATION_MODEL=qwen2.5-7b-instruct-1m

# --- Database ---
DATABASE_URL=sqlite:///./data/travel_agent.db
