# Travel Agent local environment example.
# Copy to .env only for local development. Never commit real secrets.
#
# NOTE: Per ADR 0019, PostgreSQL is the sole required relational store.
# SQLite is retired and legacy options (APP_DB_PATH, WORKSPACE_DB_PATH, AUTH_REQUIRED) are removed.

# Required only for chat readiness and external model-provider calls.
GITHUB_TOKEN=

# Backend model selection for external model-provider calls.
LLM_MODEL=gpt-4o-mini

# Model provider endpoint. REQUIRED — there is no default in the source.
# Must speak the OpenAI chat-completions protocol. For GitHub Models use
# https://models.inference.ai.azure.com . Leave it unset and the first model
# call fails with a connection error.
GITHUB_MODELS_URL=

# Browser-to-backend origin used by the Vite frontend.
VITE_API_URL=http://localhost:8000

# JSON object mapping owner_user_id to local bearer token values.
# Use synthetic values for local development and evaluation only; never commit real tokens.
# LOCAL_AUTH_TOKENS_JSON={"alice":"dev-token-alice","bob":"dev-token-bob"}

# Maximum API request body size in bytes.
# MAX_REQUEST_BODY_BYTES=1048576

# Comma-separated allowed browser origins. Wildcard "*" is strictly prohibited.
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ALLOWED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL configuration (required application store per ADR 0019).
# DATABASE_URL is the single source of truth for the backend engine and
# readiness probes, and must use the least-privilege `travel_app` role, which
# cannot bypass row-level security. Docker Compose sets DATABASE_URL
# automatically (travel_app@db:5432). Alembic migrations need the bootstrap
# superuser instead: run them with PG_DSN, never with the runtime URL.
# Set POSTGRES_PASSWORD, APP_DB_PASSWORD and WORKER_DB_PASSWORD in your local
# `.env` file. The worker role (ADR 0028) claims the cross-owner outbox queue and
# is a separate identity from the runtime role, so it has its own credential.
# DATABASE_URL=postgresql+psycopg://travel_app:app-password-dev-only@localhost:5433/travel_agent
# PG_DSN=postgresql+psycopg://travel_agent:password@localhost:5433/travel_agent
# APP_DB_PASSWORD=
# WORKER_DB_PASSWORD=
# WORKER_DATABASE_URL=postgresql+psycopg://travel_worker:worker-password-dev-only@localhost:5433/travel_agent
# PG_WORKER_USER=travel_worker
# PG_HOST=localhost
# PG_PORT=5433
# PG_DB=travel_agent
# PG_USER=travel_agent
# POSTGRES_PASSWORD=

# Integration test DSNs. Never used by the application runtime.
# Two roles, because one variable cannot serve both needs: the migration tests
# run `DROP SCHEMA public CASCADE` and need a DDL-capable role, while the
# tenant-isolation tests need a role that row-level security actually applies
# to. A superuser or BYPASSRLS role makes the isolation assertions vacuous, so
# the suite checks the role and fails rather than passing quietly.
#
# PG_TEST_DSN has NO fallback. It used to fall back to PG_DSN above — the real
# development database — which meant a developer who set PG_DSN and ran the suite
# without PG_TEST_DSN had six modules drop their own dev schema. Absent this
# variable the schema-dropping tests now skip, and a database whose name does not
# end in `_test` is refused outright.
# PG_TEST_DSN=postgresql+psycopg://travel_agent:password@localhost:5433/travel_test
# PG_RUNTIME_TEST_DSN=postgresql+psycopg://travel_app:app-password-dev-only@localhost:5433/travel_test
# A third identity for the claim boundary (ADR 0028). Optional: the suite derives
# it from PG_TEST_DSN with the worker role's credentials when it is unset.
# PG_WORKER_TEST_DSN=postgresql+psycopg://travel_worker:worker-password-dev-only@localhost:5433/travel_test

# Fail-closed RLS guard: the backend refuses to start when the connected
# role is a superuser or bypasses row-level security. Set to true ONLY for
# throwaway local development against a superuser-owned database.
# ALLOW_PRIVILEGED_DB_ROLE=false

# Semantic memory write pipeline feature gates (ADR 0016 / ADR 0017 / ADR 0020).
# MEMORY_WRITE_PIPELINE_ENABLED=false
# MEMORY_SHADOW_EXTRACT_ENABLED=false
# MEMORY_WRITE_EVAL_FIXTURES_PATH=docs/evaluation/fixtures/memory/write-pipeline-hotel-atmosphere-v0.1
