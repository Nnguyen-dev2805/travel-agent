# Travel Agent local environment example.
# Copy to .env only for local development. Never commit real secrets.

# Required only for chat readiness and external model-provider calls.
GITHUB_TOKEN=

# Backend model selection for external model-provider calls.
LLM_MODEL=gpt-4o-mini

# Browser-to-backend origin used by the Vite frontend.
VITE_API_URL=http://localhost:8000

# JSON object mapping owner_user_id to local bearer token values.
# Use synthetic values for local development and evaluation only; never commit real tokens.
# LOCAL_AUTH_TOKENS_JSON={"alice":"dev-token-alice","bob":"dev-token-bob"}

# Maximum API request body size in bytes.
# MAX_REQUEST_BODY_BYTES=1048576

# Comma-separated local browser origins.
# ALLOWED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL configuration. Set POSTGRES_PASSWORD in a local `.env` file.
# DATABASE_URL=postgresql+psycopg://travel_agent:password@localhost:5433/travel_agent
# PG_HOST=localhost
# PG_PORT=5433
# PG_DB=travel_agent
# PG_USER=travel_agent
# POSTGRES_PASSWORD=

# Memory Write Pipeline feature gates (ADR 0016 / ADR 0017).
# MEMORY_WRITE_PIPELINE_ENABLED=false
# MEMORY_SHADOW_EXTRACT_ENABLED=false
# MEMORY_WRITE_EVAL_FIXTURES_PATH=docs/evaluation/fixtures/memory/write-pipeline-hotel-atmosphere-v0.1
