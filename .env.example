# Travel Agent local environment example.
# Copy to .env only for local development. Never commit real secrets.

# Required only for Stage B chat readiness and external model-provider calls.
GITHUB_TOKEN=

# Backend model selection for external model-provider calls.
LLM_MODEL=gpt-4o-mini

# Browser-to-backend origin used by the Vite frontend.
VITE_API_URL=http://localhost:8000

# R6 feature-gated memory retrieval. The gate defaults to off: with it
# disabled, bound and unbound chat behavior remains R4/R5 behavior. Turning
# retrieval on by default requires memory evaluation evidence that satisfies
# the approved gates.
# MEMORY_RETRIEVAL_ENABLED=false

# Minimum candidate confidence eligible for memory promotion.
# MEMORY_PROMOTION_MIN_CONFIDENCE=0.75

# Maximum memory records selected per bound chat turn.
# MEMORY_MAX_SELECTED=5

# R9 local security boundary. AUTH_REQUIRED=false preserves unauthenticated
# local compatibility; true fails closed and requires a bearer token.
# AUTH_REQUIRED=false

# JSON object mapping owner_user_id to local bearer token values. Required
# when AUTH_REQUIRED=true. Use synthetic values for local development and
# evaluation only; never commit real tokens.
# LOCAL_AUTH_TOKENS_JSON={"owner_a":"local-dev-token-a","owner_b":"local-dev-token-b"}

# Maximum API request body size in bytes.
# MAX_REQUEST_BODY_BYTES=1048576

# Comma-separated local browser origins. A wildcard origin is rejected when
# AUTH_REQUIRED=true.
# ALLOWED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL for the memory write pipeline (Master Tasks 6-7). Names only;
# never commit secret values. Set POSTGRES_PASSWORD in a local `.env` file.
# PG_HOST=localhost
# PG_PORT=5433
# PG_DB=travel_agent
# PG_USER=travel_agent
# POSTGRES_PASSWORD=

# Memory Write Pipeline feature gates (Child Plan 6 / ADR 0016 / ADR 0017).
# Defaults to false (safe opt-in rollout). Set to true to activate direct write pipeline or shadow worker.
# MEMORY_WRITE_PIPELINE_ENABLED=false
# MEMORY_SHADOW_EXTRACT_ENABLED=false
# MEMORY_WRITE_EVAL_FIXTURES_PATH=docs/evaluation/fixtures/memory/write-pipeline-hotel-atmosphere-v0.1
